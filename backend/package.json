{
  "name": "quickplate-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for QuickPlate: restaurants, orders and a delivery status simulator.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
