# HTTP port for the API
PORT=4000

# Firebase Admin credentials: either a path to the service account key file...
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# ...or the key's JSON contents (used on hosts without a file system, e.g. Render)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Enables POST /v1/orders/:id/advance for demos
ENABLE_DEMO_ENDPOINTS=true

# Seconds between simulated order status steps (0 disables the simulator)
SIM_STEP_SECONDS=20

# Allowed CORS origin(s), comma separated, or * for any
CORS_ORIGIN=*

# Max requests per IP per minute
RATE_LIMIT_PER_MINUTE=120

# Number of proxies in front of the API (Render: 1). Leave 0 when running
# locally, otherwise clients could fake their IP with X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Seconds restaurant and menu reads are cached in memory (0 turns it off)
RESTAURANT_CACHE_SECONDS=60
